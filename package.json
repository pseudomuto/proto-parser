{
  "name": "@pseudomutojs/proto-parser",
  "version": "0.1.0",
  "description": "A TypeScript library for parsing Protocol Buffer (.proto) files, extracting messages, services, enums, and other definitions from both file paths and proto content strings.",
  "keywords": [
    "protobuf",
    "grpc",
    "parser"
  ],
  "homepage": "https://github.com/pseudomuto/proto-parser#readme",
  "bugs": {
    "url": "https://github.com/pseudomuto/proto-parser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pseudomuto/proto-parser.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "David Muto",
  "type": "commonjs",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .js,.ts",
    "fix": "eslint . --ext .js,.ts --fix",
    "test": "jest --watch",
    "test:ci": "jest",
    "prepare": "husky"
  },
  "files": [
    "dist"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/jest": "^25.2.3",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^25.0.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@grpc/proto-loader": "^0.8.0",
    "protobufjs": "^7.5.4"
  }
}
