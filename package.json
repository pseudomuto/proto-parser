{
  "name": "@pseudomutojs/proto-parser",
  "version": "0.3.0",
  "description": "A TypeScript library for parsing Protocol Buffer (.proto) files and generating unified IDL. Extract messages, services, enums, and other definitions from both file paths and proto content strings, with the ability to merge multiple proto files into a single IDL.",
  "keywords": [
    "protobuf",
    "grpc",
    "parser",
    "idl",
    "proto",
    "code-generation",
    "schema",
    "merge",
    "typescript"
  ],
  "homepage": "https://github.com/pseudomuto/proto-parser#readme",
  "bugs": {
    "url": "https://github.com/pseudomuto/proto-parser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pseudomuto/proto-parser.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "David Muto",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .js,.ts",
    "fix": "eslint . --ext .js,.ts --fix",
    "test": "jest --watch",
    "test:ci": "CI=true jest",
    "prepare": "husky",
    "prepublishOnly": "npm run test:ci && npm run lint && npm run build",
    "release": "bash scripts/release.sh"
  },
  "files": [
    "dist"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "protobufjs": "^7.5.4"
  }
}
